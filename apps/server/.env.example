# 服务地址
BETTER_AUTH_URL=http://localhost:3000
PORT=3000
# 登录密钥（至少 32 字符，Node 本地入口与 alchemy 部署读取）
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-chars
# CORS：默认放行 localhost / loopback / 私网开发来源
CORS_ORIGIN=http://localhost:8081
CORS_ORIGINS=
# D1 数据库 ID（与 packages/infra/wrangler.jsonc 保持一致）
D1_DATABASE_ID=replace-with-your-d1-database-id
# 可选：Google OAuth 登录
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# 可选：邮件发送（验证码/欢迎邮件）
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# 可选：R2 图片存储自定义配置
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
