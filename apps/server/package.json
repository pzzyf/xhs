{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "tsx watch src/dev.ts",
		"start": "node dist/dev.mjs",
		"build": "tsdown && tsdown --config tsdown.lambda.config.ts",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/dev.ts --outfile server",
		"zip": "zip -j lambda.zip dist/index.mjs",
		"update": "aws lambda update-function-code --zip-file fileb://lambda.zip --function-name hello",
		"deploy": "bun run build && bun run zip && bun run update"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.12",
		"@orpc/server": "^1.14.15",
		"@xhs/env": "workspace:*",
		"@xhs/rpc": "workspace:*",
		"dotenv": "catalog:",
		"hono": "^4.12.32",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@xhs/config": "workspace:*",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	}
}
