{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"dev": "wrangler dev --config ../../packages/infra/wrangler.jsonc --env-file ../../apps/server/.env --port 3000",
		"deploy": "wrangler deploy --config ../../packages/infra/wrangler.jsonc",
		"d1:migrate:local": "wrangler d1 migrations apply xhs-d1 --config ../../packages/infra/wrangler.jsonc --local",
		"d1:migrate:remote": "wrangler d1 migrations apply xhs-d1 --config ../../packages/infra/wrangler.jsonc --remote",
		"check-types": "tsc -b"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.12",
		"@orpc/server": "^1.14.15",
		"@xhs/api": "workspace:*",
		"@xhs/auth": "workspace:*",
		"@xhs/db": "workspace:*",
		"@xhs/env": "workspace:*",
		"dotenv": "catalog:",
		"hono": "^4.12.32",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260804.1",
		"@types/node": "catalog:",
		"@xhs/config": "workspace:*",
		"tsdown": "^0.22.14",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"wrangler": "^4.119.0"
	}
}
