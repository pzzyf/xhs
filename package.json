{
	"name": "xhs",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@types/node": "^22.20.1",
			"dotenv": "^17.4.2",
			"zod": "^4.4.3"
		}
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:native": "turbo run dev -F native",
		"dev:server": "turbo run dev -F server",
		"alchemy": "alchemy",
		"alchemy:dev": "alchemy dev --env-file apps/server/.env",
		"alchemy:plan": "alchemy plan --env-file apps/server/.env",
		"alchemy:deploy": "alchemy deploy --env-file apps/server/.env",
		"alchemy:adopt": "alchemy deploy --adopt --env-file apps/server/.env",
		"alchemy:destroy": "alchemy destroy --env-file apps/server/.env",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@effect/platform-bun": "4.0.0-beta.102",
		"@effect/platform-node": "4.0.0-beta.102",
		"@xhs/env": "workspace:*",
		"alchemy": "^2.0.0-beta.70",
		"dotenv": "catalog:",
		"effect": "4.0.0-beta.102",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@xhs/config": "workspace:*",
		"lefthook": "^2.1.10",
		"turbo": "^2.10.7",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.14"
}
