{
	"name": "xhs",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@types/node": "^22.20.1",
			"dotenv": "^17.4.2",
			"zod": "^4.4.3"
		}
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:native": "turbo run dev -F native",
		"dev:server": "turbo run dev -F server",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@xhs/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@xhs/config": "workspace:*",
		"turbo": "^2.10.7",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.14"
}
