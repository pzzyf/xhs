{
	"name": "xhs",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@types/node": "^22.20.1",
			"dotenv": "^17.4.2",
			"zod": "^4.4.3"
		}
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:native": "bun run --cwd apps/native dev",
		"dev:server": "bun run alchemy:dev",
		"build:web": "bun run --cwd apps/native export:web",
		"seed:images": "bun run --cwd packages/db seed:images",
		"alchemy": "alchemy packages/infra/alchemy.run.ts",
		"alchemy:dev": "alchemy dev packages/infra/alchemy.run.ts",
		"alchemy:plan": "alchemy plan packages/infra/alchemy.run.ts",
		"alchemy:deploy": "alchemy deploy packages/infra/alchemy.run.ts",
		"alchemy:adopt": "alchemy deploy --adopt packages/infra/alchemy.run.ts",
		"alchemy:destroy": "alchemy destroy packages/infra/alchemy.run.ts",
		"check": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/node": "catalog:",
		"@xhs/config": "workspace:*",
		"alchemy": "^2.0.0-beta.70",
		"lefthook": "^2.1.10",
		"turbo": "^2.10.7",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.14"
}
