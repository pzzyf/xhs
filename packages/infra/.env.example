# Cloudflare 账号 ID（Dashboard 右上角可查）
CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
# Cloudflare API Token（建议仅授予所需资源的权限）
CLOUDFLARE_API_TOKEN=replace-with-your-cloudflare-api-token
# Alchemy 加密密码：用于加密 .alchemy 状态中的秘密（alchemy.secret / Config.redacted）
# 生成方式：openssl rand -base64 32
ALCHEMY_PASSWORD=replace-with-a-strong-random-password
